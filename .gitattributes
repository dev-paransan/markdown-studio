# Normalize line endings: store text as LF in the repo, check out per-OS.
* text=auto

# Explicitly LF for source / web / config files
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.gradle text eol=lf
*.pro    text eol=lf
*.properties text eol=lf
*.sh     text eol=lf
gradlew  text eol=lf

# Windows-only scripts keep CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets — never touch line endings / no diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.keystore binary
*.jks    binary
*.p12    binary
